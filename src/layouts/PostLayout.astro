---
import type { MarkdownHeading } from 'astro';
import Pane from '../components/Pane.astro';
import PostTags from '../components/PostTags.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { formatDate, formatIsoDate } from '../lib/date';
import type { TagDefinition } from '../lib/tags';
import SiteLayout from './SiteLayout.astro';

interface Props {
  headings: MarkdownHeading[];
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  siteTags?: TagDefinition[];
}

const {
  headings,
  title,
  description,
  slug,
  publishedAt,
  updatedAt,
  tags = [],
  siteTags = [],
} = Astro.props;

const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const sourcePath = `${slug}.md`;
const hasUpdatedAt = updatedAt && updatedAt.getTime() !== publishedAt.getTime();
---

<SiteLayout type="article" title={title} description={description} siteTags={siteTags} activeSection="posts">
  <div class:list={['post-page', { 'has-toc': tocHeadings.length >= 2 }]}>
    <Pane as="article" class="post-pane" ariaLabelledBy="post-title">
      <header class="post-header">
        <p class="command-line post-command" lang="en">
          <TerminalPrompt />
          <span class="command">cat {sourcePath}</span>
        </p>
        <h1 id="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-meta">
          <p>
            <span class="post-meta-label">公開日</span>
            <time datetime={formatIsoDate(publishedAt)}>{formatDate(publishedAt)}</time>
          </p>
          {hasUpdatedAt && updatedAt && (
            <p>
              <span class="post-meta-label">更新日</span>
              <time datetime={formatIsoDate(updatedAt)}>{formatDate(updatedAt)}</time>
            </p>
          )}
        </div>
        <PostTags tags={tags} tagDefinitions={siteTags} sourceId={slug} />
      </header>
      {tocHeadings.length >= 2 && (
        <details class="inline-toc">
          <summary>この記事の目次</summary>
          <TableOfContents headings={tocHeadings} />
        </details>
      )}
      <div class="post-content">
        <slot />
      </div>
      <nav class="post-navigation" aria-label="記事ナビゲーション">
        <a href="/posts">記事一覧</a>
      </nav>
    </Pane>
    {tocHeadings.length >= 2 && (
      <Pane as="aside" class="toc-pane" ariaLabel="この記事の目次">
        <p class="toc-label">この記事の目次</p>
        <TableOfContents headings={tocHeadings} />
      </Pane>
    )}
  </div>
</SiteLayout>

<style>
  .post-pane {
    padding: 1.5rem;

    @media (max-width: 640px) {
      padding: 1.25rem;
    }
  }

  .post-page {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--pane-gap);

    @media (min-width: 1000px) {
      &.has-toc {
        grid-template-columns: minmax(0, 1fr) 208px;
      }
    }
  }

  .post-navigation {
    width: 100%;
    min-width: 0;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    font-family: var(--sans);

    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  .post-header {
    display: grid;
    width: 100%;
    padding-block: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);

    .post-command {
      margin-bottom: 0.25rem;
    }

    h1 {
      margin-block: 1.4rem 0.65rem;
      font-size: clamp(1.75rem, 3vw, 2.25rem);
    }

    .post-description {
      color: var(--muted);
      font-family: var(--sans);
      font-size: 1rem;
      line-height: 1.85;
      word-break: normal;
      word-break: auto-phrase;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      margin-top: 1.25rem;
      color: var(--muted);
      font-size: 0.76rem;

      p {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .post-meta-label {
        color: var(--green);
      }
    }
  }

  .toc-pane {
    display: none;

    @media (min-width: 1000px) {
      display: grid;
      position: sticky;
      top: 1.5rem;
      max-height: calc(100dvh - 3rem);
      overflow-y: auto;
      padding: 1rem;
    }
  }

  .toc-label {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .inline-toc {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--sans);
    font-size: 0.875rem;

    summary {
      min-height: 44px;
      align-content: center;
      cursor: pointer;
    }

    @media (min-width: 1000px) {
      display: none;
    }
  }

  .post-content {
    width: 100%;
    min-width: 0;
    padding-block: 2rem 1rem;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.85;
    word-break: normal;
    word-break: auto-phrase;

    @media (min-width: 1280px) {
      font-size: 1.125rem;
    }

    & > :global(:first-child) {
      margin-top: 0;
    }

    & > :global(* + *) {
      margin-top: 1.25rem;
    }

    & :global(h2),
    & :global(h3),
    & :global(h4),
    & :global(h5),
    & :global(h6) {
      font-feature-settings: "palt";
      text-wrap: balance;
    }

    & :global(h2) {
      margin-block: 2.8rem 0;
      font-size: 1.55rem;
      line-height: 1.5;
    }

    & :global(h3) {
      margin-block: 2.2rem 0;
      font-size: 1.25rem;
      line-height: 1.55;
    }

    & :global(h4) {
      margin-block: 1.9rem 0;
      font-size: 1.1rem;
      line-height: 1.6;
    }

    & :global(h5) {
      margin-block: 1.7rem 0;
      font-size: 1rem;
      line-height: 1.65;
    }

    & :global(h6) {
      margin-block: 1.5rem 0;
      font-size: 0.95rem;
      line-height: 1.65;
    }

    & :global(ul),
    & :global(ol) {
      padding-left: 1.6rem;
    }

    & :global(ul) {
      list-style: disc;
    }

    & :global(ol) {
      list-style: decimal;
    }

    & :global(li + li) {
      margin-top: 0.35rem;
    }

    & :global(blockquote) {
      margin-inline: 0;
      border-left: 3px solid var(--purple);
      padding-left: 1rem;
      color: var(--muted);
    }

    & :global(pre) {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 1rem;
      background: var(--bg);
      font-family: var(--mono);
      line-height: 1.7;
    }

    & :global(code) {
      border-radius: 3px;
      padding: 0.1em 0.35em;
      background: var(--selection);
      font-family: var(--mono);
      font-size: 0.9em;
      overflow-wrap: anywhere;
    }

    & :global(pre code) {
      padding: 0;
      background: transparent;
      font-size: inherit;
      overflow-wrap: normal;
    }

    & :global(a) {
      text-decoration: underline;
      overflow-wrap: anywhere;
    }

    & :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
    }

    & :global(hr) {
      border: 0;
      border-top: 1px solid var(--border);
      margin-block: 2rem;
    }

    & :global(table) {
      display: block;
      width: max-content;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
    }

    & :global(th),
    & :global(td) {
      border: 1px solid var(--border);
      padding: 0.55rem 0.75rem;
      text-align: left;
    }

    & :global(th) {
      background: var(--selection);
    }
  }
</style>
