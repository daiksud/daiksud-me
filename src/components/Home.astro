---
import type { CollectionEntry } from 'astro:content';
import { profile, site } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sortPostsByPublishedAt } from '../lib/posts';
import { deriveUsedTags, orderTagsByPostCount, type TagDefinition } from '../lib/tags';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
import Pane from './Pane.astro';
import PostList from './PostList.astro';
import TerminalPrompt from './TerminalPrompt.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  tagDefinitions: TagDefinition[];
}

const { posts, tagDefinitions } = Astro.props;
const sortedPosts = sortPostsByPublishedAt(posts);
const latestPosts = sortedPosts.slice(0, 3);
const siteTags = orderTagsByPostCount(deriveUsedTags(sortedPosts, tagDefinitions), sortedPosts);
const homeSections = [
  { label: '最新の記事', href: '#posts' },
  { label: '自己紹介', href: '#about' },
  { label: '最近のコミット', href: '#commits' },
] as const;
---

<SiteLayout siteTags={siteTags}>
  <div class="dashboard">
    <Pane class="welcome-pane" ariaLabel="ようこそ">
      <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">cat welcome.txt</span></p>
      <h1 id="welcome-heading">つくる。<wbr />試す。<wbr />書く。</h1>
      <p class="welcome-description">{site.description}</p>
      <div class="welcome-links">
        <p class="command-line" lang="en"><TerminalPrompt /> <span class="command">ls</span></p>
        <nav aria-label="このページの内容">
          {homeSections.map((item) => (
            <a href={item.href}><span aria-hidden="true">#</span>{item.label}</a>
          ))}
        </nav>
      </div>
    </Pane>

    <Pane id="posts" class="posts-pane" title="最新の記事" headingId="posts-heading" tabindex={-1}>
      <span slot="meta" class="pane-label">{posts.length}件の記事</span>
      <PostList posts={latestPosts} tagDefinitions={tagDefinitions} headingLevel="h3" />
      <p slot="footer" class="pane-footnote"><span aria-hidden="true">// </span>小さく進めて、学び続ける。</p>
    </Pane>

    <Pane id="about" class="about-pane" title="自己紹介" headingId="about-heading" tabindex={-1}>
      <div class="profile-top">
        <img class="avatar" src={profile.avatarUrl} alt="daiksudのGitHubアバター" width="160" height="160" decoding="async" referrerpolicy="no-referrer" />
        <div>
          <h3>{profile.name}</h3>
          <p class="profile-role">{profile.role}</p>
          <p class="profile-location" lang="en"><Icon name="location" size={16} /><span>{profile.location}</span></p>
        </div>
      </div>
      <p class="profile-bio">{profile.bio}</p>
      <div class="profile-actions">
        <a class="text-link" href="/profile">プロフィールを見る <Icon name="arrow" size={16} /></a>
        <ul class="profile-links" lang="en">
          <li><a href={profile.githubUrl} target="_blank" rel="noopener"><BrandLogo name="github" size={16} />GitHub</a></li>
          <li><a href={profile.xUrl} target="_blank" rel="noopener"><BrandLogo name="x" size={16} />X</a></li>
          <li><a href={profile.zennUrl} target="_blank" rel="noopener"><BrandLogo name="zenn" size={16} />Zenn</a></li>
        </ul>
      </div>
    </Pane>

    <Pane id="commits" class="commits-pane" title="最近のコミット" headingId="commits-heading" tabindex={-1}>
      <a slot="meta" class="pane-link" href={site.commitsUrl} lang="en" target="_blank" rel="noopener">GitHub <Icon name="arrow" size={16} /></a>
      <div class="repository-summary">
        <span class="repository-icon"><Icon name="branch" size={26} /></span>
        <div>
          <p class="repository-name">{site.name}</p>
          <p class="repository-description">このサイトを少しずつ育てています。</p>
        </div>
      </div>
      <a class="text-link" href={site.commitsUrl} target="_blank" rel="noopener">GitHubで変更履歴を見る <Icon name="arrow" size={16} /></a>
    </Pane>
  </div>
</SiteLayout>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pane-gap);
    align-items: start;

    @media (max-width: 999px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .welcome-pane,
  .posts-pane {
    grid-column: 1 / -1;
  }

  h1 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    margin-block: 0.65rem;
  }

  .welcome-description {
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.85;
    word-break: normal;
    word-break: auto-phrase;

    @media (max-width: 640px) {
      font-size: 0.95rem;
    }
  }

  .welcome-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.25rem;
    margin-top: 0.75rem;

    nav {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1ch;
    }

    a {
      display: inline-grid;
      grid-auto-flow: column;
      align-items: center;
      min-height: 44px;
      gap: 0.25rem;
      font-size: 0.9rem;
      white-space: nowrap;

      @media (max-width: 640px) {
        font-size: 0.85rem;
      }
    }
  }

  .profile-top {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;

    h3 {
      font-size: 1.5rem;
      line-height: 1.3;
      font-feature-settings: "palt";
      text-wrap: balance;
    }
  }

  .avatar {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--selection);
  }

  .profile-role,
  .profile-location {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .profile-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .profile-bio {
    margin-top: 1rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--muted);
    word-break: normal;
    word-break: auto-phrase;
  }

  .profile-actions,
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .profile-actions {
    justify-content: space-between;
    margin-top: 0.75rem;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-size: 0.75rem;
  }

  .pane-link {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
    gap: 0.5rem;
    min-height: 28px;
    font-size: 0.72rem;
    text-decoration: underline;
  }

  .pane-footnote {
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .repository-summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem;
    margin-block: 1.1rem;
  }

  .repository-icon {
    color: var(--green);
    padding-top: 0.1rem;
  }

  .repository-name {
    color: var(--blue);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .repository-description {
    margin-top: 0.25rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--muted);
    word-break: normal;
    word-break: auto-phrase;
  }

  .text-link {
    display: inline-grid;
    grid-auto-flow: column;
    justify-content: start;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    min-height: 44px;
    text-decoration: underline;
    word-break: normal;
    word-break: auto-phrase;
  }
</style>
