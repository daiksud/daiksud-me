{
  "name": "daiksud-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "test": "vitest run src tests/content.build.test.mjs",
    "test:ci": "node --test ./tests/ci/preview.test.mjs && python3 -B -m unittest discover -s tests/ci -p 'test_*.py'",
    "test:smoke": "node scripts/ci/smoke.mjs",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/content.build.test.mjs",
    "test:acceptance": "pnpm run build && node scripts/ci/acceptance.mjs",
    "commitlint": "commitlint --strict"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.3",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.136.3"
  },
  "packageManager": "pnpm@12.18.0"
}
